<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api/?$ api/index.php [QSA,L]
  RewriteRule ^api/health/?$ api/health.php [QSA,L]
  RewriteRule ^api/auth/login/?$ api/auth/login.php [QSA,L]
  RewriteRule ^api/products/?([0-9]+)?$ api/products.php [QSA,L]
  RewriteRule ^api/uploads/([^/]+)$ api/uploads.php?file=$1 [QSA,L]
  RewriteRule ^api/upload/?$ api/upload.php [QSA,L]
  RewriteRule ^api/contact/?$ api/contact.php [QSA,L]
  RewriteRule ^api/enquiries/?([0-9]+)?$ api/enquiries.php [QSA,L]
  RewriteRule ^api/machines/?([0-9]+)?$ api/machines.php [QSA,L]
  RewriteRule ^api/machine_categories/?([0-9]+)?$ api/machine_categories.php [QSA,L]
  RewriteRule ^api/machine_subcategories/?([0-9]+)?$ api/machine_subcategories.php [QSA,L]
  RewriteRule ^api/machine_enquiries/?([0-9]+)?$ api/machine_enquiries.php [QSA,L]
  RewriteRule ^api/(.+)$ api/$1 [QSA,L]

  RewriteRule ^index\.html$ - [L]

  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
